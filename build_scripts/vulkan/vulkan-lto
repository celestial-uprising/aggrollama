#!/usr/bin/env bash

echo "===  {START}: Building AggroLlama-Z3:Vulkan+Aggro+LTO  ==="

set -e

source /opt/AMD/aocc-compiler-5.2.0/setenv_AOCC.sh
AOCC="/opt/AMD/aocc-compiler-5.2.0/bin"

# Removed -ffast-math and -flto flags; appended -fno-finite-math-only to satisfy llama.cpp checks
export AGGRO="-march=native -mtune=znver3 -Ofast -funroll-loops -ftree-vectorize -mprefer-vector-width=256 -fomit-frame-pointer -fstrict-aliasing -stdlib=libc++ -fno-finite-math-only -Wno-pass-failed"
export OMP_PROC_BIND=TRUE

# --- DISTROBOX VULKAN PASSTHROUGH FIX ---
export VK_ICD_FILENAMES=/run/host/usr/share/vulkan/icd.d/radeon_icd.x86_64.json
# If on Nvidia, swap the commenting:
# export VK_ICD_FILENAMES=/run/host/usr/share/vulkan/icd.d/nvidia_icd.x86_64.json
# ----------------------------------------

cd "$HOME/.src/llama.cpp"
rm -rf build

git fetch --all
git fetch --tags --all
git reset --hard origin/master || git reset --hard
git pull

# Let llama.cpp handle LTO via -DLLAMA_LTO=ON instead of hardcoding arbitrary link flags
cmake -B build -G Ninja \
  -DCMAKE_BUILD_TYPE=Release \
  -DCMAKE_C_COMPILER="${AOCC}/clang" \
  -DCMAKE_CXX_COMPILER="${AOCC}/clang++" \
  -DCMAKE_C_FLAGS="$AGGRO" \
  -DCMAKE_CXX_FLAGS="$AGGRO" \
  -DCMAKE_BUILD_WITH_INSTALL_RPATH=ON \
  -DGGML_NATIVE=ON \
  -DGGML_LTO=ON \
  -DCMAKE_EXE_LINKER_FLAGS="-s -lmimalloc -stdlib=libc++ -Wl,--allow-multiple-definition" \
  -DCMAKE_SHARED_LINKER_FLAGS="-s -lmimalloc -stdlib=libc++ -Wl,--allow-multiple-definition" \
  -DCMAKE_MODULE_LINKER_FLAGS="-s -lmimalloc -stdlib=libc++ -Wl,--allow-multiple-definition" \
  -DGGML_MIMALLOC=ON \
  -DCMAKE_INSTALL_RPATH="\$ORIGIN" \
  -DGGML_BACKEND_DL=OFF \
  -DGGML_VULKAN=ON \
  -DVulkan_LIBRARY=/usr/lib64/libvulkan.so \
  -DVulkan_INCLUDE_DIR=/usr/include

ninja -C build

echo "===  {END}: AggroLlama-Z3 Vulkan LTO Build Completed!  ==="

